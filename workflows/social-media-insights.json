    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const result = {\n  PostId: $json.id || $node[\"Code1\"].json.id,  // in some cases the id comes from the insights response\n  Reach: 0,\n  Likes: 0,\n};\n\nfor (const metric of $json.data) {\n  if (metric.name === \"post_impressions\") {\n    result.Reach = metric.values[0].value;\n  }\n\n  if (metric.name === \"post_reactions_by_type_total\") {\n    const reactions = metric.values[0].value;\n    result.Likes = Object.values(reactions).reduce((a, b) => a + b, 0);\n  }\n}\n\nreturn { json: result };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
