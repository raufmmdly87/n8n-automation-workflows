    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const postId = String($json.id).trim();\nconst createdTime = new Date($json.created_time);\n\n// Get the date components\nconst year = createdTime.getUTCFullYear();\nconst month = String(createdTime.getUTCMonth() + 1).padStart(2, '0');\nconst day = String(createdTime.getUTCDate()).padStart(2, '0');\nconst hours = String(createdTime.getUTCHours()).padStart(2, '0');\nconst minutes = String(createdTime.getUTCMinutes()).padStart(2, '0');\n\n// Same format as Instagram: YYYY-MM-DDTHH:mm\nconst roundedTime = `${year}-${month}-${day}T${hours}:${minutes}`;\n\nreturn {\n  json: {\n    PostId: postId,\n    CreatedTime: $json.created_time,\n    RoundedTime: roundedTime\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
