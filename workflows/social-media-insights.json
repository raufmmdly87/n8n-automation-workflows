      "parameters": {
        "url": "=https://graph.facebook.com/v22.0/{{ $json.postId }}/insights?metric=reach,views,likes,comments,saved,shares,total_interactions&access_token={{ $env.META_ACCESS_TOKEN }}",
        "options": {}
