      "parameters": {
        "jsCode": "// Build one clean row per cross-posted piece of content\nreturn items.map(item => {\n  const d = item.json;\n  return {\n    json: {\n      posted_at: d.roundedTime,\n      instagram_post_id: d.id,\n      facebook_post_id: d.PostId,\n      ig_reach: d.reach ?? 0,\n      ig_views: d.views ?? 0,\n      ig_likes: d.likes ?? 0,\n      ig_comments: d.comments ?? 0,\n      ig_saves: d.saved ?? 0,\n      ig_shares: d.shares ?? 0,\n      ig_total_interactions: d.total_interactions ?? 0,\n      fb_impressions: d.Reach ?? 0,\n      fb_reactions: d.Likes ?? 0,\n      fb_comments: d.Comments ?? 0,\n      collected_at: new Date().toISOString(),\n    },\n  };\n});\n"
      },
