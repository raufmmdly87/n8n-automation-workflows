    },
    {
      "parameters": {
        "jsCode": "// Turn the Instagram insights response into one flat row per post\nreturn items.map(item => {\n  const metrics = item.json.data || [];\n  const row = { id: null };\n\n  for (const metric of metrics) {\n    // metric.id looks like \"<postId>/insights/<metric>/lifetime\"\n    if (!row.id && metric.id) row.id = metric.id.split('/')[0];\n    row[metric.name] = metric.values?.[0]?.value ?? 0;\n  }\n\n  return { json: row };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        180
      ],
      "id": "84eb1ac7-06f0-564d-9980-1c61fca6ac60",
      "name": "Code5"
    },
